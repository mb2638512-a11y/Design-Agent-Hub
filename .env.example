# App
APP_NAME=Design Agent Hub
APP_ENV=development
# Set APP_ENV=production and a strong API_BEARER_TOKEN before public deployment.
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Optional primary OpenAI-compatible model endpoint. Leave empty for deterministic planning.
# Use only a provider/model you are authorized to access.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Optional fallback model; tried if the primary endpoint fails or returns invalid output.
# Keep provider keys private and use compatible chat-completions endpoints.
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_NAME=

# Optional local task memory. Disabled by default to protect privacy.
# Set true to store up to 100 compact task summaries in a local SQLite database.
MANAGER_MEMORY_ENABLED=false
MANAGER_MEMORY_PATH=.design_agent_hub_memory.sqlite3

# Figma. Use a private local .env or secret manager; never commit real credentials.
FIGMA_ACCESS_TOKEN=
FIGMA_API_BASE_URL=https://api.figma.com

# Canva Connect API. OAuth setup and scopes depend on the integration and endpoints used.
CANVA_ACCESS_TOKEN=
CANVA_API_BASE_URL=https://api.canva.com/rest

# Security: set a long random value before exposing the service beyond localhost.
API_BEARER_TOKEN=

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
