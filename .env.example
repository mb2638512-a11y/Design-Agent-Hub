# App
APP_NAME=Design Agent Hub
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Optional OpenAI-compatible model endpoint. Leave empty for deterministic planning.
# Use only a provider/model you are authorized to access.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Figma. Use a private local .env or secret manager; never commit real credentials.
FIGMA_ACCESS_TOKEN=
FIGMA_API_BASE_URL=https://api.figma.com

# Canva Connect API. OAuth setup and scopes depend on the integration and endpoints used.
CANVA_ACCESS_TOKEN=
CANVA_API_BASE_URL=https://api.canva.com/rest

# Security: set a long random value before exposing the service beyond localhost.
# The current scaffold is intended for local/trusted use; add production authentication before public deployment.
API_BEARER_TOKEN=
